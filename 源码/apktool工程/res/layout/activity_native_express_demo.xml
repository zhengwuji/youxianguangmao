<?xml version="1.0" encoding="utf-8"?>
<ScrollView android:background="#d3d3d3" android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout android:id="@id/activity_native_express" android:background="#d3d3d3" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:gravity="center" android:id="@id/textWidth" android:layout_width="wrap_content" android:layout_height="50.0dp" android:layout_marginLeft="16.0dp" android:layout_marginRight="16.0dp" android:text="宽：" />
        <EditText android:id="@id/editWidth" android:layout_width="120.0dp" android:layout_height="50.0dp" android:text="340" android:maxLines="1" android:layout_toRightOf="@id/textWidth" android:layout_alignBottom="@id/textWidth" android:inputType="number" />
        <CheckBox android:id="@id/checkboxFullWidth" android:layout_width="wrap_content" android:layout_height="50.0dp" android:layout_marginLeft="16.0dp" android:text="最大宽度" android:layout_toRightOf="@id/editWidth" android:layout_alignBottom="@id/textWidth" />
        <TextView android:gravity="center" android:id="@id/textHeight" android:layout_width="wrap_content" android:layout_height="50.0dp" android:layout_marginLeft="16.0dp" android:layout_marginRight="16.0dp" android:text="高：" android:layout_below="@id/textWidth" />
        <EditText android:enabled="false" android:id="@id/editHeight" android:layout_width="120.0dp" android:layout_height="50.0dp" android:text="-2" android:maxLines="1" android:layout_toRightOf="@id/textHeight" android:layout_alignBottom="@id/textHeight" android:inputType="number" />
        <CheckBox android:id="@id/checkboxAutoHeight" android:layout_width="wrap_content" android:layout_height="50.0dp" android:layout_marginLeft="16.0dp" android:checked="true" android:text="自适应高度" android:layout_toRightOf="@id/editHeight" android:layout_alignBottom="@id/textHeight" />
        <TextView android:textStyle="italic" android:id="@id/textSizeHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginLeft="16.0dp" android:layout_marginRight="16.0dp" android:text="上面的宽、高单位为dp，可以在这里调出合适的尺寸\nADSize.AUTO_HEIGHT可以让NativeExpressADView的高度根据广告内容自适应\n" android:layout_below="@id/buttonDestroy" />
        <Button android:id="@id/buttonRefresh" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="16.0dp" android:layout_marginRight="16.0dp" android:text="加载并展示广告" android:layout_below="@id/textSizeHint" android:layout_alignParentLeft="true" />
        <TextView android:textStyle="italic" android:id="@id/txtRefreshTip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="16.0dp" android:layout_marginRight="2.0dp" android:text="如果是视频广告，直接展示。会显示下载进度条，需要视频加载完成才会播放。" android:layout_below="@id/buttonRefresh" android:layout_alignParentLeft="true" />
        <Button android:id="@id/buttonPreloadVideo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="16.0dp" android:layout_marginTop="16.0dp" android:layout_marginRight="2.0dp" android:text="加载广告(调用预加载视频接口)" android:layout_below="@id/txtRefreshTip" android:layout_alignParentLeft="true" />
        <TextView android:textStyle="italic" android:id="@id/txtPreloadVideoTip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="16.0dp" android:layout_marginRight="2.0dp" android:text="如果是视频广告，会在加载完视频素材后展示。不显示下载进度条，直接是可播放状态。" android:layout_below="@id/buttonPreloadVideo" android:layout_alignParentLeft="true" />
        <Button android:id="@id/buttonDestroy" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="16.0dp" android:layout_marginRight="16.0dp" android:text="调整尺寸" android:layout_below="@id/textHeight" android:layout_alignParentLeft="true" />
        <FrameLayout android:id="@id/container" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16.0dp" android:layout_marginBottom="16.0dp" android:layout_below="@id/txtPreloadVideoTip" android:layout_centerHorizontal="true" />
    </RelativeLayout>
</ScrollView>
